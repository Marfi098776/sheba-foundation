# Canadian Sheba Foundation - Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# EMAIL CONFIGURATION (Resend)
# =============================================================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=

# The email address that will receive contact form and volunteer submissions
CONTACT_RECIPIENT_EMAIL=

# The "From" address for outgoing emails (must be a verified domain in Resend)
# Example: "Canadian Sheba Foundation <noreply@yourdomain.com>"
EMAIL_FROM=

# =============================================================================
# WHATSAPP CONFIGURATION
# =============================================================================
# WhatsApp phone number in international format (e.g., +15551234567)
# This is used to generate wa.me links
WHATSAPP_PHONE=

# =============================================================================
# SITE CONFIGURATION (Optional - for future phases)
# =============================================================================
# Production domain for canonical URLs and sitemap
# SITE_URL=https://canadiansheba.org